# SMTP configuration for SmartGov email notifications
#
# Set these values to match your SMTP server.
# Example for a typical TLS SMTP server (e.g. Gmail / Outlook relay):
#
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASSWORD=your_smtp_password
# SMTP_USE_TLS=1
# FROM_EMAIL=no-reply@smartgov.local
#
# NOTE: The FastAPI app reads these using os.getenv in main.py.
# Make sure your environment actually loads this .env file
# (for example via your IDE, a process manager, or python-dotenv).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=assphaltxd@gmail.com
SMTP_PASSWORD=teob jhsw lpbx gnvs
SMTP_USE_TLS=1
FROM_EMAIL=assphaltxd@gmail.com

